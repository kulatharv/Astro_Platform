APP_NAME=AstroLogicAI
ENVIRONMENT=development
DEBUG=true

# Database Configuration
DATABASE_URL=sqlite:///./astrologic.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800

# Security & Secrets (Required: App will crash on startup if missing)
SECRET_KEY=
SESSION_SECRET_KEY=
JWT_SECRET_KEY=
CORS_ORIGINS=*

# External AI & Integrations (Optional)
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3
